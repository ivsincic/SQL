SELECT DATE AS datum,
                current_date - DATE AS proteklo
         FROM crime2
         LIMIT 5;


SELECT DATE AS datum,
                         current_date - DATE AS proteklo
                  FROM crime2;


SELECT DATE AS datum,
                                  current_date - DATE AS proteklo
                           FROM crime2
         order by proteklo;



SELECT DATE AS datum,
                                           current_date - DATE AS proteklo
                                    FROM crime2
                  order by proteklo desc;


SELECT *, current_date - DATE AS proteklo
                                             FROM crime2
                           order by proteklo desc;



SELECT *, current_date - DATE AS proteklo
                                                      FROM crime2
                                    order by proteklo asc;


